{
  "expo": {
    "name": "Mormon News Roundup",
    "slug": "mormon-news-roundup",
    "version": "1.0.0",
    "description": "Your Daily Mormon News: Unfiltered",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mormonnewsroundup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mormonnewsroundup.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSUserTrackingUsageDescription": "This identifier is used to show ads that are more relevant to you. Ads support Mormon News Roundup. You can remove them with a one-time purchase.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mormonnewsroundup.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D1838",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1D1838"
        }
      ],
      "expo-dev-client",
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "This identifier is used to show ads that are more relevant to you. Ads support Mormon News Roundup. You can remove them with a one-time purchase.",
          "delayAppMeasurementInit": true,
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "contentRating": "17+",
      "privacyPolicyUrl": "https://mormonnewsroundup.org/privacy",
      "supportUrl": "https://mormonnewsroundup.org/app-support"
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/mormon-news-roundup"
    }
  }
}
