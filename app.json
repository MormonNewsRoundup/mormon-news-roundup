{
  "expo": {
    "name": "Mormon News Roundup",
    "slug": "mormon-news-roundup",
    "version": "1.0.1",
    "description": "Your Daily Mormon News: Unfiltered",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mormonnewsroundup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mormonnewsroundup.app",
      "buildNumber": "5",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
